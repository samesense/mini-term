+        /// Phase-preserving special/modifier injection through the native funnel.
+        @discardableResult
+        func sendKey(_ press: TerminalKeyPress, action: TerminalKeyAction) -> Bool {
+            if press.key == .escape && action == .press { stopKeyRepeat() }
+            return press.withKeyEvent(action: action.ghosttyAction) { sendInputKeyEvent($0) }
+        }
