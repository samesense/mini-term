+public enum TerminalKeyAction: Sendable {
+    case press, release, `repeat`
+    var ghosttyAction: ghostty_input_action_e {
+        switch self {
+        case .press: GHOSTTY_ACTION_PRESS
+        case .release: GHOSTTY_ACTION_RELEASE
+        case .repeat: GHOSTTY_ACTION_REPEAT
+        }
+    }
+}
